# Шаблон env-переменных. Скопируй в .env и заполни:
#   copy .env.example .env  (Windows)
#   cp .env.example .env    (Linux/Mac)
#
# Файл .env УЖЕ в .gitignore — секреты не уйдут в репо.

# === Docker (docker-compose.yml) ===
# UID/GID пользователя op на хосте — контейнеры backend/updater работают
# под ним же, чтобы файлы в примонтированных downloads/, data/, state/,
# logs/ не оказались владельцем root. Узнать: id -u op && id -g op
OP_UID=1000
OP_GID=1000
WEB_PORT=8080
# Текущий выпуск + два предыдущих; остальные переносятся в runtime/_archive/releases/.
# Архив сохраняется бессрочно. Минимум 2; удаление файлов не выполняется.
RELEASE_KEEP=3
# Ежедневно проверяются все восемь источников, включая ЕРЗ.
# Недоступный сайт пропускается с причиной; сохраняются его прежние данные.
UPDATE_ERZ=1

# === Dashboard accounts ===
# Docker defaults to required login. Accounts and sessions use the persistent
# auth_state volume, separate from runtime/live. No passwords belong in .env/Git.
PARSER_AUTH_ENABLED=1
# Keep 0 on a domain with HTTPS. Set 1 only for a local HTTP SSH tunnel while
# configuring TLS; never send passwords over public unencrypted HTTP.
PARSER_AUTH_ALLOW_HTTP=0

# === TDM Bot API (мэрия Москвы, web.tdm.mos.ru) ===

# 1) Токен бота (authToken) — выдаётся при создании бота
TDM_BOT_TOKEN=

# 2) ID пространства (workspaceId) — Long, привязан к боту
TDM_WORKSPACE_ID=

# 3) ID группы куда слать уведомления (groupId) — Long
TDM_GROUP_ID=

# Узнать workspaceId и groupId:
#   1. Добавь бота в нужную группу TDM
#   2. py -m pipeline.tdm_notify --groups
#      → выведет все группы где бот участвует, с их groupId+workspaceId

# (опционально) Base URL'ы — из официальной доки (api.pdf, раздел 6):
# TDM_API_BASE=https://api.tdm.mos.ru          ← REST endpoints (default)
# TDM_FILE_BASE=https://fileupload.tdm.mos.ru  ← Загрузка файлов (default)
# Поменяй только если у вашего инстанса TDM другие домены.

# (опционально) '1' чтобы временно выключить отправку
# TDM_DISABLED=0

# === Управление per-dev обходом квартирографии ===
# Docker updater всегда задаёт KVART_PER_DEV=1: полный per-dev обход.
# KVART_PER_DEV_LIMIT=5      # ограничить кол-во для теста
# KVART_PER_DEV_DEBUG=1      # debug-вывод для первых 3 девелоперов
