# Шаблон env-переменных. Скопируй в .env и заполни:
#   copy .env.example .env  (Windows)
#   cp .env.example .env    (Linux/Mac)
#
# Файл .env УЖЕ в .gitignore — секреты не уйдут в репозиторий.

# === TDM уведомления ===
# TDM мэрии Москвы (web.tdm.mos.ru) — корпоративный мессенджер.
# API похож на VK Teams / MyTeam (форк ICQ Bot API).
#
# Токен бота — получи у администратора TDM или панели разработчика
TDM_BOT_TOKEN=

# ID чата куда слать уведомления.
# Узнать:
#   1. Напиши боту любое сообщение в TDM
#   2. py -m pipeline.tdm_notify --list-chats
TDM_CHAT_ID=

# (опционально) Base URL API. Default: MyTeam-стиль.
# Если у TDM Мос.Ру свой endpoint — узнай у админа и поставь сюда.
# Возможные варианты:
#   https://api.internal.myteam.mail.ru/bot/v1   ← MyTeam (по умолчанию)
#   https://api.tdm.mos.ru/bot/v1                ← TDM Мос.Ру (предположение)
#   https://web.tdm.mos.ru/api/bot/v1            ← TDM Мос.Ру (альт. вариант)
#   https://botapi.tamtam.chat                   ← TamTam
#
# Чтобы автоматически перебрать варианты:
#   py -m pipeline.tdm_notify --detect
# TDM_API_BASE=

# (опционально) Стиль API: 'myteam' (default, для VK Teams/ICQ/TDM)
# или 'tamtam' (для botapi.tamtam.chat)
# TDM_API_STYLE=myteam

# (опционально) '1' чтобы временно выключить отправку
# TDM_DISABLED=0

# === Управление per-dev обходом квартирографии ===
# KVART_PER_DEV=1            # включить per-dev обход (по умолчанию выключен)
# KVART_PER_DEV_LIMIT=5      # ограничить кол-во для теста
# KVART_PER_DEV_DEBUG=1      # debug-вывод для первых 3 девелоперов
