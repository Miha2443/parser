# Local API proxy. Restart Vite after changes.
DASHBOARD_API_TARGET=http://127.0.0.1:8000
VITE_DATA_MODE=api

# Optional XYZ raster provider. All VITE_* values are visible in the browser.
# Keep the provider's required attribution. Do not put private tokens here.
# VITE_MAP_TILE_URL=https://your-tile-server.example/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=Your provider attribution
