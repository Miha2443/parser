# Шаблон env-переменных. Скопируй в .env и заполни:
#   copy .env.example .env  (Windows)
#   cp .env.example .env    (Linux/Mac)
#
# Файл .env УЖЕ в .gitignore — секреты не уйдут в репозиторий.

# === TDM (TamTam-bot) уведомления ===
# Токен бота получаешь у @PrimeBot или панели управления TDM
TDM_BOT_TOKEN=

# ID чата куда слать уведомления.
# Узнать: напиши боту → запусти `py -m pipeline.tdm_notify --list-chats`
TDM_CHAT_ID=

# (опционально) Base URL API — для TamTam = https://botapi.tamtam.chat
# TDM_API_BASE=https://botapi.tamtam.chat

# (опционально) '1' чтобы временно отключить отправку без удаления токена
# TDM_DISABLED=0

# === Управление per-dev обходом квартирографии ===
# KVART_PER_DEV=1            # включить per-dev обход (по умолчанию выключен)
# KVART_PER_DEV_LIMIT=5      # ограничить кол-во для теста
# KVART_PER_DEV_DEBUG=1      # debug-вывод для первых 3 девелоперов
